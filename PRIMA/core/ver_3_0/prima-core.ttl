ro:0002323 a owl:ObjectProperty ;
    rdfs:label "mereotopologically related to"@en ;
    iao:0000115 "A mereological relationship or a topological relationship" ;
    iao:0000117 <https://orcid.org/0000-0002-6601-2165> ;
