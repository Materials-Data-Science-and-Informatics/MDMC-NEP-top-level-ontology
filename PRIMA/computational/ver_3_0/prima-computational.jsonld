  {
    "@id": "https://purls.helmholtz-metadaten.de/prima/computational#Calculation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Computational Data Acquisition performed by one or more Research Users on a Model to process its input Settings into output calculated properties using a specific computational and/or theoretical Technique based on a theory accepted by the scientific community (e.g., Density Functional Theory, Conformal Field Theory)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
