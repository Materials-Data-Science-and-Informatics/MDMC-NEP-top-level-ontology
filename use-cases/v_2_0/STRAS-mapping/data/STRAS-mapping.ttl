@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.org/STRAS_RESEARCH_GROUP/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pmd: <https://w3id.org/pmd/co/> .
@prefix prima-core: <https://purls.helmholtz-metadaten.de/prima/core#> .
@prefix prima-dal: <https://purls.helmholtz-metadaten.de/prima/dal#> .
@prefix prima-dataset: <https://purls.helmholtz-metadaten.de/prima/dataset#> .
@prefix prima-exp: <https://purls.helmholtz-metadaten.de/prima/experiment#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Analysis_Software a prima-core:ResearchSoftware .

ex:filtered_image a prima-dataset:ProcessedData ;
    prov:wasAttributedTo ex:Alice ;
    prov:wasDerivedFrom ex:Structured_and_FAIR_dataset_1 ;
    pmd:outputOf ex:metadata_selection_1 .

ex:sample_quality_check a prima-exp:Measurement ;
    prima-core:usesEquipment ex:LEED_instrument ;
    pmd:input ex:graphe_sample .

ex:study_1 a prima-core:Study ;
    prov:wasAssociatedWith ex:towards_fairification_stm_data ;
    prima-core:hasDataAnalysisLifecycle ex:image_labelling_process_1 ;
    prima-exp:hasMeasurement ex:VT_STM_measurement_1998_1 .

ex:study_2 a prima-core:Study ;
    prov:wasAssociatedWith ex:towards_fairification_stm_data ;
    prima-exp:hasMeasurement ex:VT_STM_measurement_1998_2 .

dcterms:contributor a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

<http://qudt.org/schema/qudt/numericValue> a owl:DatatypeProperty .

<http://qudt.org/schema/qudt/value> a owl:DatatypeProperty .

<http://w3id.org/STREAM/MSLE#Equipment> a owl:Class ;
    rdfs:label "equipment" ;
    owl:equivalentClass prima-core:Equipment .

skos:closeMatch a owl:AnnotationProperty .

skos:exactMatch a owl:AnnotationProperty .

prov:endedAtTime a owl:DatatypeProperty .

prov:generated a owl:ObjectProperty ;
    owl:inverseOf prov:wasGeneratedBy .

prov:startedAtTime a owl:DatatypeProperty .

prov:used a owl:ObjectProperty .

prov:wasInfluencedBy a owl:ObjectProperty .

prima-core:ContactPerson a owl:Class ;
    rdfs:label "Contact Person"@en ;
    rdfs:comment "Person with knowledge of how to access, troubleshoot, or otherwise field issues related to the resource."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/contactperson> ;
    rdfs:subClassOf prima-core:AgentRole ;
    skos:closeMatch <http://purl.org/datacite/v4.4/ContactPerson> ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/contactperson> .

prima-core:DataCollector a owl:Class ;
    rdfs:label "Data Collector"@en ;
    rdfs:comment "Person/institution responsible for finding or gathering/collecting data under the guidelines of the author(s) or Principal Investigator (PI)."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/datacollector> ;
    rdfs:subClassOf prima-core:AgentRole ;
    skos:closeMatch <http://purl.org/datacite/v4.4/DataCollector> ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/datacollector> .

prima-core:MDMCNEPGlossaryDefinition a owl:AnnotationProperty ;
    rdfs:subPropertyOf skos:definition .

prima-core:ProjectLeader a owl:Class ;
    rdfs:label "Project Leader"@en ;
    rdfs:comment "Person officially designated as head of project team or sub- project team instrumental in the work necessary to development of the resource."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/projectleader> ;
    rdfs:subClassOf prima-core:ProjectMember ;
    skos:closeMatch <http://purl.org/datacite/v4.4/ProjectLeader> ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/projectleader> .

prima-core:ProjectManager a owl:Class ;
    rdfs:label "Project Manager"@en ;
    rdfs:comment "Person officially designated as manager of a project. Project may consist of one or many project teams and sub-teams."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/projectmanager> ;
    rdfs:subClassOf prima-core:ProjectMember ;
    skos:closeMatch <http://purl.org/datacite/v4.4/ProjectManager> ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/projectmanager> .

prima-core:RelatedPerson a owl:Class ;
    rdfs:label "Related Person"@en ;
    rdfs:comment "A person without a specifically defined role in the development of the resource, but who is someone the author wishes to recognize."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/relatedperson> ;
    rdfs:subClassOf prima-core:AgentRole ;
    skos:closeMatch <http://purl.org/datacite/v4.4/RelatedPerson> ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/relatedperson> .

prima-core:Researcher a owl:Class ;
    rdfs:label "Researcher"@en ;
    rdfs:comment "A person involved in analysing data or the results of an experiment or formal study. May indicate an intern or assistant to one of the authors who helped with research but who was not so “key” as to be listed as an author."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/researcher> ;
    rdfs:subClassOf prima-core:AgentRole ;
    skos:closeMatch <http://purl.org/datacite/v4.4/Researcher> ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/researcher> .

prima-core:Supervisor a owl:Class ;
    rdfs:label "Supervisor"@en ;
    rdfs:comment "Designated administrator over one or more groups/teams working to produce a resource, or over one or more steps of a development process."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/supervisor> ;
    rdfs:subClassOf prima-core:AgentRole ;
    skos:closeMatch <http://purl.org/datacite/v4.4/Supervisor> ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/supervisor> .

prima-core:WorkPackageLeader a owl:Class ;
    rdfs:label "Work Package Leader"@en ;
    rdfs:comment "Person responsible for ensuring the comprehensive contents, versioning, and availability of the Work Package during the development of the resource."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/workpackageleader> ;
    rdfs:subClassOf prima-core:AgentRole ;
    skos:closeMatch <http://purl.org/datacite/v4.4/WorkPackageLeader> ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/workpackageleader> .

prima-core:contributorType a owl:ObjectProperty ;
    rdfs:isDefinedBy "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/)" ;
    rdfs:subPropertyOf prima-core:performsAgentRole .

prima-core:hasStudy a owl:ObjectProperty ;
    rdfs:label "has study"@en ;
    rdfs:comment "hasStudy represents the relationship between project to study."@en ;
    rdfs:domain prima-core:Project ;
    rdfs:range prima-core:Study .

<https://purls.helmholtz-metadaten.de/prima/dal> a owl:Ontology ;
    dcterms:contributor "Elda Osmenaj"@en,
        "Mirco Panighel"@en ;
    dcterms:created "2024-01-29"@en ;
    dcterms:creator "Ahmad Zainul Ihsan"@en,
        "Mehrdad Jalali"@en,
        "Rossella Aversa"@en ;
    dcterms:license <http://creativecommons.org/licenses/by/3.0/> ;
    dcterms:title "PRIMA Ontology- Data Analysis Lifecycle Module"@en ;
    vann:preferredNamespacePrefix "PRIMA"@en ;
    rdfs:comment "This is the data analysis lifecycle module of the Provenance Information for Materials Science (PRIMA) Ontology"@en ;
    rdfs:seeAlso <https://github.com/Materials-Data-Science-and-Informatics/MDMC-NEP-top-level-ontology> ;
    owl:imports <https://purls.helmholtz-metadaten.de/prima/core> ;
    owl:versionInfo "2.0"@en .

prima-dal:DataAnalysis a owl:Class ;
    rdfs:comment "Set of actions performed by one or more Research Users, possibly using a Technique and Research Software, on Research Data, typically Processed Data, to extract insights that support the answer to some scientific research question. Data Analysis may include: linear combination fitting, least-squares curve fitting, data modelling, pattern extraction and/or segmentation, data visualization. The output of Data Analysis is Analyzed Data."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/dataanalysis> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pmd:input ;
            owl:someValuesFrom prima-core:ResearchData ],
        [ a owl:Restriction ;
            owl:onProperty pmd:input ;
            owl:someValuesFrom prima-dataset:ProcessedData ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasAssociatedWith ;
            owl:someValuesFrom prima-core:ResearchUser ],
        [ a owl:Restriction ;
            owl:onProperty prima-core:usesResearchSoftware ;
            owl:someValuesFrom prima-core:ResearchSoftware ],
        [ a owl:Restriction ;
            owl:onProperty pmd:output ;
            owl:someValuesFrom prima-dataset:AnalyzedData ],
        pmd:Process ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/dataanalysis> .

prima-dal:MDMCNEPGlossaryDefinition a owl:AnnotationProperty ;
    rdfs:subPropertyOf skos:definition .

<https://purls.helmholtz-metadaten.de/prima/dataset> a owl:Ontology ;
    dcterms:contributor "Elda Osmenaj"@en,
        "Mirco Panighel"@en ;
    dcterms:created "2024-01-26"@en ;
    dcterms:creator "Ahmad Zainul Ihsan"@en,
        "Mehrdad Jalali"@en,
        "Rossella Aversa"@en ;
    dcterms:license <http://creativecommons.org/licenses/by/3.0/> ;
    dcterms:title "PRIMA Ontology - Dataset Module"@en ;
    vann:preferredNamespacePrefix "PRIMA"@en ;
    rdfs:comment "This is the dataset module of the Provenance Information for Materials Science (PRIMA) Ontology"@en ;
    rdfs:seeAlso <https://github.com/Materials-Data-Science-and-Informatics/MDMC-NEP-top-level-ontology> ;
    owl:imports <https://purls.helmholtz-metadaten.de/prima/core> ;
    owl:versionInfo "2.0"@en .

prima-dataset:DataCurator a owl:Class ;
    rdfs:label "Data Curator"@en ;
    rdfs:comment "Person tasked with reviewing, enhancing, cleaning, or standardizing metadata and the associated data submitted for storage, use, and maintenance within a data centre or repository."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/datacurator> ;
    rdfs:subClassOf prima-core:AgentRole ;
    skos:closeMatch <http://purl.org/datacite/v4.4/DataCurator> ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/datacurator> .

prima-dataset:DataManager a owl:Class ;
    rdfs:label "Data Manager"@en ;
    rdfs:comment "Person responsible for maintaining the finished resource."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/datamanager> ;
    rdfs:subClassOf prima-core:AgentRole ;
    skos:closeMatch <http://purl.org/datacite/v4.4/DataManager> ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/datamanager> .

prima-dataset:hasDataCuration a owl:ObjectProperty ;
    rdfs:label "has data curation"@en ;
    rdfs:comment "hasDataCuration represents the relationship between study to data curation"@en ;
    rdfs:domain prima-core:Study ;
    rdfs:range prima-dataset:DataCuration .

prima-dataset:hasPersistentIdentifier a owl:ObjectProperty ;
    rdfs:label "has persistent identifier"@en ;
    rdfs:comment "hasPersistentIdentifier represents the relationship between a resource and its persistent identifier"@en ;
    rdfs:range prima-dataset:PersistentIdentifier .

<https://purls.helmholtz-metadaten.de/prima/experiment> a owl:Ontology ;
    dcterms:contributor "Elda Osmenaj"@en,
        "Mirco Panighel"@en ;
    dcterms:created "2024-01-29"@en ;
    dcterms:creator "Ahmad Zainul Ihsan"@en,
        "Mehrdad Jalali"@en,
        "Rossella Aversa"@en ;
    dcterms:license <http://creativecommons.org/licenses/by/3.0/> ;
    dcterms:title "PRIMA Ontology - Experiment Module"@en ;
    vann:preferredNamespacePrefix "PRIMA"@en ;
    rdfs:comment "This is the experiment module of the Provenance Information for Materials Science (PRIMA) Ontology"@en ;
    rdfs:seeAlso <https://github.com/Materials-Data-Science-and-Informatics/MDMC-NEP-top-level-ontology> ;
    owl:imports <https://purls.helmholtz-metadaten.de/prima/core> ;
    owl:versionInfo "2.0"@en .

prima-exp:InstrumentScientist a owl:Class ;
    rdfs:label "Instrument Scientist"@en ;
    rdfs:comment "Person who manages a particular Instrument, or a set of them."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/instrumentscientist> ;
    rdfs:subClassOf prima-core:AgentRole ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/instrumentscientist> .

prima-exp:hasMeasurementTechnique a owl:ObjectProperty ;
    rdfs:label "has measurement technique"@en ;
    rdfs:comment "hasMeasurementTechnique represents the relationship between measurement to measurement technique."@en ;
    rdfs:domain prima-exp:Measurement .

pmd:composes a owl:ObjectProperty ;
    rdfs:domain pmd:Object ;
    rdfs:range pmd:Object .

ex:Graphene_growth_sample_preparation a prima-exp:SamplePreparation ;
    prima-core:usesEquipment ex:gas_line_1,
        ex:heating_gun_1,
        ex:sputter_gun_1 ;
    pmd:input ex:ethylene_1,
        ex:sample_1_component_Ni .

ex:LEED_instrument a prima-core:Instrument .

ex:VT_STM_Microscopy a prima-core:Instrument .

ex:ethylene_1 a prima-exp:SampleComponent .

ex:gas_line_1 a prima-core:Equipment .

ex:heating_gun_1 a prima-core:Equipment .

ex:image_labelling_process_1 a prima-core:DataAnalysisLifecycle ;
    prov:wasAssociatedWith ex:Bob,
        ex:STRAS_Research_Group ;
    prima-dal:hasDataProcessing ex:image_selection_and_retrievement_1,
        ex:image_selection_and_retrievement_2,
        ex:metadata_selection_1 ;
    pmd:input ex:Reference_Dataset_1 ;
    pmd:output ex:Structured_and_FAIR_dataset_1 .

ex:image_selection_and_retrievement_1 a prima-dal:DataProcessing ;
    prov:wasAssociatedWith ex:Bob ;
    pmd:input ex:raw_data_1998_1,
        ex:raw_data_1998_2 ;
    pmd:output ex:Reference_Dataset_1 .

ex:image_selection_and_retrievement_2 a prima-dal:DataProcessing .

ex:raw_data_1998_1 a prima-dataset:RawData ;
    pmd:outputOf ex:VT_STM_measurement_1998_1 .

ex:raw_data_1998_2 a prima-dataset:RawData ;
    pmd:outputOf ex:VT_STM_measurement_1998_2 .

ex:sample_1_component_Ni a prima-exp:SampleComponent ;
    prima-exp:isHeldBy ex:sample_holder_1 .

ex:sample_holder_1 a prima-exp:SampleHolder .

ex:sputter_gun_1 a prima-core:Equipment .

<http://qudt.org/schema/qudt/Quantity> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://qudt.org/schema/qudt/QuantityKind> ;
            owl:onProperty <http://qudt.org/schema/qudt/hasQuantityKind> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://qudt.org/schema/qudt/QuantityValue> ;
            owl:onProperty <http://qudt.org/schema/qudt/quantityValue> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://qudt.org/schema/qudt/QuantityValue> ;
            owl:onProperty <http://qudt.org/schema/qudt/quantityValue> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://qudt.org/schema/qudt/QuantityKind> ;
            owl:onProperty <http://qudt.org/schema/qudt/hasQuantityKind> ] .

prov:Activity a owl:Class .

prov:Collection a owl:Class ;
    rdfs:subClassOf prov:Entity .

prov:Location a owl:Class .

prov:Organization a owl:Class ;
    rdfs:subClassOf prov:Agent .

prov:wasInformedBy a owl:ObjectProperty .

prima-core:UserRole a owl:Class ;
    rdfs:label "User Role"@en ;
    rdfs:comment "The role of the Research User in a Project, in the context of a specific Study. Examples of User Role are: data curator, project leader, project member. User Role also determines the access rights which might be granted in the information system(s) used for data management (i.e., Data Collaboration Platform, Data Repository, Metadata Repository)."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/userrole> ;
    skos:closeMatch <http://purl.org/datacite/v4.4/ContributorType> ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/userrole> .

prima-core:hasDataAnalysis a owl:ObjectProperty ;
    rdfs:label "has data analysis"@en ;
    rdfs:comment "hasDataAnalysis represents the relationship between study to data analysis"@en ;
    rdfs:domain prima-core:Study ;
    rdfs:range prima-core:DataAnalysis .

prima-core:hasScientificPublication a owl:ObjectProperty ;
    rdfs:label "has scientific publication"@en ;
    rdfs:comment "hasScientificPublication represents the relationship between study to scientific publication"@en ;
    rdfs:domain prima-core:Study ;
    rdfs:range prima-core:ScientificPublication .

prima-core:isMemberOfProject a owl:ObjectProperty ;
    rdfs:label "is member of project"@en ;
    rdfs:comment "isMemberOfProject is the inverse of hasProjectMember, representing the relationship from research user to project"@en ;
    owl:inverseOf prima-core:hasProjectMember .

prima-core:operates a owl:ObjectProperty ;
    rdfs:label "operates"@en ;
    rdfs:comment "operates represents the relationship between equipment to research user"@en ;
    rdfs:domain prima-core:ResearchUser ;
    rdfs:range prima-core:Equipment .

prima-dal:isUsedByResearchSoftware a owl:ObjectProperty ;
    rdfs:label "is used by research software"@en ;
    rdfs:comment "isUsedByResearchSoftware is the inverse of usesResearchSoftware, representing the relationship from research software to the processes that use it"@en ;
    owl:inverseOf prima-core:usesResearchSoftware .

prima-dataset:AnalyzedData a owl:Class ;
    rdfs:comment "Specific type of Research Data, primary output of any kind of Data Analysis performed on Research Data, typically on Processed Data.",
        "Specific type of Research Data, primary output of any kind of Data Analysis performed on Research Data, typically on Processed Data."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/analyzeddata> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:wasGeneratedBy ;
            owl:someValuesFrom prima-core:DataAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasDerivedFrom ;
            owl:someValuesFrom prima-dataset:RawData ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasDerivedFrom ;
            owl:someValuesFrom prima-dataset:RawData ],
        [ a owl:Restriction ;
            owl:onProperty dcterms:references ;
            owl:someValuesFrom prima-dataset:ReferenceData ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasDerivedFrom ;
            owl:someValuesFrom prima-dataset:ProcessedData ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasDerivedFrom ;
            owl:someValuesFrom prima-dataset:ProcessedData ],
        [ a owl:Restriction ;
            owl:onProperty dcterms:references ;
            owl:someValuesFrom prima-dataset:ReferenceData ],
        prima-core:ResearchData ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/analyzeddata> .

prima-dataset:PersistentIdentifier a owl:Class ;
    rdfs:label "Persistent Identifier"@en ;
    rdfs:comment "Long-lasting reference which provides the information required to reliably identify, verify, and locate a digital resource, e.g., Research Data (typically, but not limited to, Publication Data), Metadata, Scientific Publications, but also Systems, Research Users, Equipment, and/or Institutions."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/persistentidentifier> ;
    rdfs:subClassOf prov:Entity ;
    skos:closeMatch <https://terms.codata.org/rdmt/persistent-identifier> ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/persistentidentifier> .

prima-exp:Institution a owl:Class ;
    rdfs:comment "Hierarchical entity which hosts one or more Laboratories."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/institution> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prima-exp:hosts ;
            owl:someValuesFrom prima-exp:Laboratory ],
        prov:Organization ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/institution> .

prima-exp:carries a owl:ObjectProperty ;
    rdfs:label "carries"@en ;
    rdfs:comment "carries represents the relationship between sample carrier to sample."@en ;
    rdfs:domain prima-exp:SampleCarrier ;
    rdfs:range prima-exp:Sample ;
    owl:inverseOf prima-exp:isCarriedBy .

prima-exp:hasAcquisitionSoftware a owl:ObjectProperty ;
    rdfs:label "has acquisition software"@en ;
    rdfs:comment "hasAcquisitionSoftware represents the relationship between instrument to acquisition software"@en ;
    rdfs:domain prima-core:Instrument ;
    rdfs:range prima-exp:AcquisitionSoftware .

prima-exp:hasMaterial a owl:ObjectProperty ;
    rdfs:label "has material"@en ;
    rdfs:comment "Direct relationship between Sample and Material(s) it is composed of"@en ;
    rdfs:domain prima-exp:Sample ;
    rdfs:range prima-core:Material ;
    owl:inverseOf prima-exp:isMaterialOf .

prima-exp:hasMeasurement a owl:ObjectProperty ;
    rdfs:label "has measurement"@en ;
    rdfs:comment "hasMeasurement represents the relationship between experiment to measurement."@en ;
    rdfs:range prima-exp:Measurement ;
    rdfs:subPropertyOf prima-core:hasDataAcquisition ;
    owl:inverseOf prima-exp:isMeasurementOf .

prima-exp:hasProcessingAndTreatment a owl:ObjectProperty ;
    rdfs:label "has processing and treatment"@en ;
    rdfs:comment "hasProcessingAndTreatment represents the relationship between study to processing and treatment activity."@en ;
    rdfs:domain prima-core:Study ;
    rdfs:range prima-exp:ProcessingAndTreatment .

prima-exp:holds a owl:ObjectProperty ;
    rdfs:label "holds"@en ;
    rdfs:comment "holds represents the relationship between sample carrier to sample holder."@en ;
    rdfs:domain prima-exp:SampleCarrier ;
    rdfs:range prima-exp:SampleHolder ;
    owl:inverseOf prima-exp:isHeldBy .

prima-exp:hosts a owl:ObjectProperty ;
    rdfs:label "hosts"@en ;
    rdfs:comment "hosts represents the relationship between institution to laboratory."@en ;
    rdfs:domain prima-exp:Institution ;
    rdfs:range prima-exp:Laboratory .

prima-exp:isMaterialOf a owl:ObjectProperty ;
    rdfs:label "is material of"@en ;
    rdfs:comment "isMaterialOf is the inverse property of hasMaterial."@en .

prima-exp:isMeasurementOf a owl:ObjectProperty ;
    rdfs:label "is measurement of"@en ;
    rdfs:comment "isMeasurementOf is the inverse property of hasMeasurement."@en .

pmd:characteristicOf a owl:ObjectProperty .

pmd:inputOf a owl:ObjectProperty .

pmd:outputOf a owl:ObjectProperty ;
    rdfs:subPropertyOf owl:topObjectProperty .

pmd:participantOf a owl:ObjectProperty .

pmd:previousProcess a owl:ObjectProperty .

ex:Reference_Dataset_1 a prima-core:ResearchData ;
    prov:wasAssociatedWith ex:Bob,
        ex:STRAS_Research_Group ;
    prov:wasAttributedTo ex:STRAS_Research_Group .

ex:VT_STM_measurement_1998_1 a prima-exp:Measurement ;
    prov:endedAtTime "1998-05-20"^^xsd:date ;
    prov:startedAtTime "1998-04-20"^^xsd:date ;
    prov:wasAssociatedWith ex:STRAS_Research_Group,
        ex:VT_STM_Microscopy ;
    pmd:input ex:graphe_sample .

ex:VT_STM_measurement_1998_2 a prima-exp:Measurement ;
    prov:endedAtTime "1998-05-21"^^xsd:date ;
    prov:startedAtTime "1998-04-21"^^xsd:date .

ex:graphe_sample a prima-exp:Sample ;
    pmd:outputOf ex:Graphene_growth_sample_preparation .

ex:metadata_selection_1 a prima-dal:DataProcessing ;
    prov:wasAttributedTo ex:Alice ;
    pmd:input ex:Structured_and_FAIR_dataset_1 .

ex:project_member_role a prima-core:ProjectMemberRole .

ex:towards_fairification_stm_data a prima-core:Project ;
    prov:wasAttributedTo ex:STRAS_Research_Group ;
    prima-core:hasProjectMember ex:Alice,
        ex:Bob .

<http://nfdi.fiz-karlsruhe.de/ontology/Specification> a owl:Class ;
    rdfs:subClassOf prov:Entity .

<http://qudt.org/schema/qudt/QuantityKind> a owl:Class .

<http://qudt.org/schema/qudt/QuantityValue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://qudt.org/schema/qudt/Unit> ;
            owl:onProperty <http://qudt.org/schema/qudt/unit> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://qudt.org/schema/qudt/Unit> ;
            owl:onProperty <http://qudt.org/schema/qudt/unit> ] .

<http://qudt.org/schema/qudt/Unit> a owl:Class .

<http://qudt.org/schema/qudt/hasQuantityKind> a owl:ObjectProperty .

<http://qudt.org/schema/qudt/quantityValue> a owl:ObjectProperty .

<http://qudt.org/schema/qudt/unit> a owl:ObjectProperty .

skos:definition a owl:AnnotationProperty .

prov:SoftwareAgent a owl:Class ;
    rdfs:subClassOf prov:Agent .

prov:hadMember a owl:ObjectProperty .

prima-core:ProjectMember a owl:Class ;
    rdfs:label "Project Member"@en ;
    rdfs:comment "Person on the membership list of a designated project/project team."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/projectmember> ;
    rdfs:subClassOf prima-core:AgentRole ;
    skos:closeMatch <http://purl.org/datacite/v4.4/ProjectMember> ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/projectmember> .

prima-core:ScientificPublication a owl:Class ;
    rdfs:label "Scientific Publication"@en ;
    rdfs:comment "Any of the following contributions, peer-reviewed or not: article in a scientific journal (and related supporting information), monograph, book or book chapter, conference proceedings, “grey literature” (informally published material having not gone through a standard publishing process, e.g., reports and highlights). A Scientific Publication typically reports the results and the conclusions of a Study, may be supplemented by Publication Data, and may be assigned a Persistent Identifier. A Scientific Publication may be attributed to some or to all the Research Users who are members of the Project."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/scientificpublication> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:wasAttributedTo ;
            owl:someValuesFrom prima-core:ResearchUser ],
        prov:Entity ;
    skos:closeMatch <http://nfdi.fiz-karlsruhe.de/ontology/Publication>,
        schema:PublicationEvent ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/scientificpublication> .

prima-core:hasProjectMember a owl:ObjectProperty ;
    rdfs:label "has project member"@en ;
    rdfs:comment "hasProjectMember represents the relationship between project and its member, which is research user."@en ;
    owl:inverseOf prima-core:isMemberOfProject .

prima-dataset:DataCollaborationPlatform a owl:Class ;
    rdfs:comment "Operational information system which allows Research Users to keep their Research Data, Datasets, and related documents (e.g., notes or drafts of Scientific Publications) synchronized and up to date and to share them with other Research Users, who are typically members of the same Project. The access rights granted to the resources may be determined by the User Role. The system is intended for the long-tail, unstructured, and still volatile data, which may change and is still subject to active research. Therefore, a Data Collaboration Platform offers versioning of all ingested files but does not usually assign them Persistent Identifiers. A Data Collaboration Platform may be associated with an Institution or a group of them, or may be run by a third party." ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/datacollaborationplatform> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prima-dataset:stores ;
            owl:someValuesFrom prima-dataset:Dataset ] ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/datacollaborationplatform> .

prima-dataset:DataCuration a owl:Class ;
    rdfs:label "Data Curation"@en ;
    rdfs:comment "Set of actions performed by one or more Research Users on Research Data and/or Datasets using a Technique to cleanse, document, standardize, format and inter-relate them, with the goal of ensuring they are fit for the purpose and available for discovery and reuse. This includes (but is not limited to): forming a new Dataset from several data sources, annotating Research Data and/or a Dataset with Metadata, maintaining links with published materials (Publication Data and/or Scientific Publications). For dynamic Datasets this may mean continuous enrichment or updating. Special forms of Data Curation (e.g., versioning) may be available in Data Repositories."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/datacuration> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pmd:output ;
            owl:someValuesFrom prima-core:ResearchData ],
        [ a owl:Restriction ;
            owl:onProperty pmd:input ;
            owl:someValuesFrom prima-core:ResearchData ],
        [ a owl:Restriction ;
            owl:onProperty prima-core:usesResearchSoftware ;
            owl:someValuesFrom prima-core:ResearchSoftware ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasAssociatedWith ;
            owl:someValuesFrom prima-core:ResearchUser ],
        pmd:Process ;
    skos:closeMatch <https://terms.codata.org/rdmt/data-curation> ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/datacuration> .

prima-dataset:MetadataRepository a owl:Class ;
    rdfs:comment "Information system used to store, manage and provide access to Metadata, following a policy or a set of rules that define storage and access norms. Many Data Repositories automatically assign globally unique Persistent Identifiers to deposited resources. A Metadata Repository may be associated with an Institution or a group of them, or may be run by a third party. A Metadata Repository may or may not be directly used by Research Users. The access rights granted to the resources may be determined by the User Role."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/metadatarepository> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prima-dataset:stores ;
            owl:someValuesFrom prima-dataset:Metadata ] ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/metadatarepository> .

prima-dataset:PublicationData a owl:Class ;
    rdfs:comment "Dataset(s) generated in the course of a Study, that has undergone quality assessment and Data Curation, and can be cited as a reliable source (i.e., a Persistent Identifier is assigned to it) to, e.g., reproduce the results and/or support the conclusions presented in a Scientific Publication or appearing in it. Publication Data may be attributed to some or to all the Research Users who are members of the Project."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/publicationdata> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prima-dataset:isStoredIn ;
            owl:someValuesFrom prima-dataset:DataRepository ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasDerivedFrom ;
            owl:someValuesFrom prima-dataset:Dataset ],
        [ a owl:Restriction ;
            owl:onProperty prima-dataset:hasMetadata ;
            owl:someValuesFrom prima-dataset:Metadata ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasAttributedTo ;
            owl:someValuesFrom prima-core:ResearchUser ],
        pmd:DigitalEntity ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/publicationdata> .

prima-exp:ProcessingAndTreatment a owl:Class ;
    rdfs:comment "Set of actions (physical changes or chemical reactions) carried out by one or more Research Users, a commercial enterprise, or a third party, performed on (or between) one or more physical Systems to produce them, treat them, or prepare them for a subsequent Measurement, under controlled conditions described by Settings. Processing and Treatment may require the use of Equipment and Consumables. One or more Measurements may also be performed during Processing and Treatment, e.g., to characterize the intermediate stages and/or the final resulting physical System(s). The output of Processing and Treatment is one or more physical Systems. Examples of Processing and Treatment are: synthesis, fabrication, any type of Material or Sample treatment (e.g., thermo-mechanical or surface treatment), and Sample preparation."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/processingandtreatment> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prima-core:usesEquipment ;
            owl:someValuesFrom prima-core:Instrument ],
        [ a owl:Restriction ;
            owl:onProperty prima-core:hasTechnique ;
            owl:someValuesFrom prima-core:Technique ],
        [ a owl:Restriction ;
            owl:onProperty prima-core:hasDataAcquisition ;
            owl:someValuesFrom prima-core:DataAcquisition ],
        [ a owl:Restriction ;
            owl:onProperty pmd:input ;
            owl:someValuesFrom prima-core:System ],
        [ a owl:Restriction ;
            owl:onProperty prov:atLocation ;
            owl:someValuesFrom prima-exp:Laboratory ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasAssociatedWith ;
            owl:someValuesFrom prima-core:ResearchUser ],
        [ a owl:Restriction ;
            owl:onProperty pmd:output ;
            owl:someValuesFrom prima-core:System ],
        [ a owl:Restriction ;
            owl:onProperty prima-core:usesEquipment ;
            owl:someValuesFrom prima-core:Equipment ],
        [ a owl:Restriction ;
            owl:onProperty prima-exp:uses ;
            owl:someValuesFrom prima-exp:Consumable ],
        pmd:Process ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/processingandtreatment> .

prima-exp:isCarriedBy a owl:ObjectProperty ;
    rdfs:label "is carried by"@en ;
    rdfs:comment "isCarriedBy is the inverse property of carries."@en .

prima-exp:isHeldBy a owl:ObjectProperty ;
    rdfs:label "is held by"@en ;
    rdfs:comment "isHeldBy is the inverse property of holds."@en .

prima-exp:uses a owl:ObjectProperty ;
    rdfs:comment "uses is an object property relating the thing with a consumable." ;
    rdfs:range prima-exp:Consumable ;
    rdfs:subPropertyOf pmd:participant .

pmd:nextProcess a owl:ObjectProperty ;
    rdfs:domain pmd:Process ;
    rdfs:range pmd:Process ;
    rdfs:subPropertyOf prov:wasInformedBy ;
    owl:inverseOf pmd:previousProcess .

pmd:subordinateProcess a owl:ObjectProperty ;
    rdfs:domain pmd:Process ;
    rdfs:range pmd:Process .

ex:Alice a prima-core:ResearchUser ;
    prima-core:performsAgentRole ex:project_member_role .

ex:Structured_and_FAIR_dataset_1 a prima-core:ResearchData ;
    prov:wasAttributedTo ex:Bob,
        ex:STRAS_Research_Group .

prov:atLocation a owl:ObjectProperty .

prov:wasGeneratedBy a owl:ObjectProperty .

<https://purls.helmholtz-metadaten.de/prima/core> a owl:Ontology ;
    dcterms:contributor "Elda Osmenaj"@en,
        "Mirco Panighel"@en ;
    dcterms:created "2024-01-26"@en ;
    dcterms:creator "Ahmad Zainul Ihsan"@en,
        "Mehrdad Jalali"@en,
        "Rossella Aversa"@en ;
    dcterms:license <http://creativecommons.org/licenses/by/3.0/> ;
    dcterms:title "PRIMA Ontology - Core Module"@en ;
    vann:preferredNamespacePrefix "PRIMA"@en ;
    rdfs:comment "This is the core module of the Provenance Information for Materials Science (PRIMA) Ontology"@en ;
    rdfs:seeAlso <https://github.com/Materials-Data-Science-and-Informatics/MDMC-NEP-top-level-ontology> ;
    owl:versionInfo "2.0"@en .

prima-core:Material a owl:Class ;
    rdfs:comment "Broad term used to define a physical System, typically a substance or mixture of substances, in different states of matter or phases, of which something is composed or can be made. According to this definition, a Sample is constituted by at least one Material. Material(s) may undergo some kind of Processing and Treatment and/or Measurement."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/material> ;
    rdfs:subClassOf prima-core:System ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/material> .

prima-core:Project a owl:Class ;
    rdfs:comment "Enterprise (potentially individual but typically collaborative) of one or more Research Users, planned to perform one or more Studies." ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/project> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prima-core:hasProjectMember ;
            owl:someValuesFrom prima-core:ResearchUser ],
        prov:Entity ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/project> .

prima-core:hasDataAcquisition a owl:ObjectProperty ;
    rdfs:label "has data acquisition"@en ;
    rdfs:comment "hasDataAcquisition represents the relationship between study to data acquisition"@en ;
    rdfs:range prima-core:DataAcquisition .

prima-core:hasSetting a owl:ObjectProperty ;
    rdfs:label "has setting"@en ;
    rdfs:comment "hasSetting represents the relationship between equipment or research software or acquisition software to settings"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( prima-core:Equipment prima-core:ResearchSoftware prima-exp:AcquisitionSoftware ) ] ;
    rdfs:range prima-core:Settings .

prima-core:hasTechnique a owl:ObjectProperty ;
    rdfs:label "has technique"@en ;
    rdfs:comment "hasTechnique represents the relationship between data acquisition or data analysis to technique"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( prima-core:DataAcquisition prima-core:DataAnalysis ) ] ;
    rdfs:range prima-core:Technique .

prima-core:performsAgentRole a owl:ObjectProperty ;
    rdfs:label "performs agent role"@en ;
    rdfs:comment "performsAgentRole relates prov:Agent with AgentRole"@en ;
    rdfs:domain prov:Agent ;
    rdfs:range prima-core:AgentRole .

prima-dataset:DataRepository a owl:Class ;
    rdfs:comment "Information system used to store, manage, and provide access to digital resources, following a set of rules that define storage and access norms. A Data Repository is particularly suitable for (but not limited to) Publication Data, which is not likely to be altered again. Many Data Repositories automatically assign globally unique Persistent Identifiers to deposited resources. A Data Repository may be associated with an Institution or a group of them, or may be run by a third party. A Data Repository may or may not be directly used by Research Users. The access rights granted to the resources may be determined by the User Role."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/datarepository> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prima-dataset:stores ;
            owl:someValuesFrom prima-dataset:PublicationData ],
        [ a owl:Restriction ;
            owl:onProperty prima-dataset:stores ;
            owl:someValuesFrom prima-dataset:Dataset ] ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/datarepository> .

prima-dataset:hasMetadata a owl:ObjectProperty ;
    rdfs:label "has metadata"@en ;
    rdfs:comment "hasMetadata represents the relationship between dataset or publication data or reasearch data to metadata"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( prima-core:ResearchData prima-dataset:Dataset prima-dataset:PublicationData ) ] ;
    rdfs:range prima-dataset:Metadata .

prima-exp:AcquisitionSoftware a owl:Class ;
    rdfs:label "Acquisition Software"@en ;
    rdfs:comment "Any software designed to interface directly with an Instrument in order to control and monitor Data Acquisition parameters (i.e., Settings), and to collect Raw Data. Regardless of whether the Acquisition Software is integrated with the Instrument or operates as a standalone application (e.g., installed on a separate computer or packaged as a virtual machine), it is considered part of the Instrument."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/acquisitionsoftware> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prima-core:hasSetting ;
            owl:someValuesFrom prima-core:Settings ],
        prov:SoftwareAgent ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/acquisitionsoftware> .

prima-exp:Consumable a owl:Class ;
    rdfs:comment "Auxiliary entity, normally acquired from third-party manufacturers, used during Processing and Treatment or Measurement which has a limited time capacity or is limited in its number of uses before it is disposed of. Consumables are not part of the Instrument. Examples of Consumable are: gloves, syringes, wipes, etching solutions, glass slides, spatulas, weighing paper, two-sided tape."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/consumable> ;
    rdfs:subClassOf pmd:Object ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/consumable> .

prima-exp:SampleHolder a owl:Class ;
    rdfs:comment "Piece of Equipment used for making one or more Samples accessible for a Measurement or for holding them in place in the predefined position to be mounted inside the Instrument. Examples of Sample Holder are: a glass slide, a TEM grid, or a tilting support. Depending on the scientific use case, a Sample Holder may carry or be carried by a Sample Carrier."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/sampleholder> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prima-exp:isHeldBy ;
            owl:someValuesFrom prima-exp:SampleCarrier ],
        prima-core:Equipment ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/sampleholder> .

pmd:participant a owl:ObjectProperty ;
    rdfs:domain pmd:Process ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( pmd:DigitalEntity pmd:Object pmd:ValueObject ) ],
        [ a owl:Class ;
            owl:unionOf ( pmd:DigitalEntity pmd:Object pmd:ValueObject ) ] ;
    owl:inverseOf pmd:participantOf .

dcterms:references a owl:ObjectProperty .

prima-core:Settings a owl:Class ;
    rdfs:comment "Any set of configuration parameters which determine the operational conditions of Equipment (including Instrument), configure Acquisition Software and/or Research Software, and/or describe a Model (e.g., by specifying the type of solver user)."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/settings> ;
    rdfs:subClassOf <http://nfdi.fiz-karlsruhe.de/ontology/Specification> ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/settings> .

prima-core:Technique a owl:Class ;
    rdfs:comment "Any experimental, theoretical, or computational method with a specific aim, including but not limited to: process and/or treat Samples, prepare Models, acquire and/or analyze Research Data, using some Equipment."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/technique> ;
    rdfs:subClassOf <http://nfdi.fiz-karlsruhe.de/ontology/Specification> ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/technique> .

prima-core:usesEquipment a owl:ObjectProperty ;
    rdfs:label "uses equipment"@en ;
    rdfs:comment "usesEquipment represents the relationship between data acquisition to equipment"@en ;
    rdfs:range prima-core:Equipment .

prima-exp:SampleCarrier a owl:Class ;
    rdfs:comment "Piece of Equipment used for carrying one or more Samples and/or one or more Sample Holders (depending on the scientific use case), which is helpful for, e.g., referencing, handling, or height adjustment. Examples of Sample Carrier are: a naked wafer, a glass slide, an individually designed metal frame, but also a Si crystal carrying a Sample of exfoliated graphene."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/samplecarrier> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prima-exp:holds ;
            owl:someValuesFrom prima-exp:SampleHolder ],
        [ a owl:Restriction ;
            owl:onProperty prima-exp:carries ;
            owl:someValuesFrom prima-exp:Sample ],
        prima-core:Equipment ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/samplecarrier> .

pmd:characteristic a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( pmd:Object pmd:Process pmd:ValueObject ) ],
        [ a owl:Class ;
            owl:unionOf ( pmd:Object pmd:Process pmd:ValueObject ) ] ;
    rdfs:range pmd:ValueObject ;
    owl:inverseOf pmd:characteristicOf .

ex:Bob a prima-core:ResearchUser ;
    prima-core:performsAgentRole ex:project_member_role .

prov:Agent a owl:Class .

prima-core:DataAnalysis a owl:Class ;
    rdfs:comment "Set of actions performed by one or more Research Users, possibly using a Technique and Research Software, on Research Data, typically Processed Data, to extract insights that support the answer to some scientific research question. Data Analysis may include: linear combination fitting, least-squares curve fitting, data modelling, pattern extraction and/or segmentation, data visualization. The output of Data Analysis is Analyzed Data."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/dataanalysis> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pmd:output ;
            owl:someValuesFrom prima-core:ResearchData ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasAssociatedWith ;
            owl:someValuesFrom prima-core:ResearchUser ],
        [ a owl:Restriction ;
            owl:onProperty prima-core:usesResearchSoftware ;
            owl:someValuesFrom prima-core:ResearchSoftware ],
        [ a owl:Restriction ;
            owl:onProperty pmd:input ;
            owl:someValuesFrom prima-core:ResearchData ],
        [ a owl:Restriction ;
            owl:onProperty prima-core:hasTechnique ;
            owl:someValuesFrom prima-core:Technique ],
        pmd:Process ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/dataanalysis> .

prima-core:Instrument a owl:Class ;
    rdfs:comment "Physical or virtual identifiable piece of Equipment used to perform a Data Acquisition and to generate Raw Data. The Instrument is located in a (physical or virtual) Laboratory hosted by an Institution and can be physically, virtually, and/or remotely accessed. A virtual Instrument may be any computational resource or HPC infrastructure (cloud infrastructure or supercomputer) needed to perform Calculations or Simulations."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/instrument> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prima-exp:hasAcquisitionSoftware ;
            owl:someValuesFrom prima-exp:AcquisitionSoftware ],
        prima-core:Equipment ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/instrument> .

prima-core:System a owl:Class ;
    rdfs:comment "Physical or digital entity or set of entities with distinctive properties (structural, chemical, dimensional, functional, or others) which is the subject of one or more actions or investigations. According to this definition, Sample, Material, and Model are particular types of System."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/system> ;
    rdfs:subClassOf prov:Entity ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/system> .

prima-dal:DataProcessing a owl:Class ;
    rdfs:comment "Set of actions performed by one or more Research Users, possibly using a Technique and Research Software, on Research Data, typically Reference Data or Raw Data, to prepare it for one or more further processes, e.g., Model Preparation, computational Data Acquisition, and/or Data Analysis. Data Processing usually consists of routine actions. It may include: filtering, denoising, transformation, fusion and/or compression of Research Data, as well as calibration, normalization, statistical data reduction, background subtraction and/or correction of artifacts. The output of Data Processing is Processed Data."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/dataprocessing> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pmd:input ;
            owl:someValuesFrom prima-dataset:ReferenceData ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasAssociatedWith ;
            owl:someValuesFrom prima-core:ResearchUser ],
        [ a owl:Restriction ;
            owl:onProperty pmd:input ;
            owl:someValuesFrom prima-dataset:RawData ],
        [ a owl:Restriction ;
            owl:onProperty prima-core:usesResearchSoftware ;
            owl:someValuesFrom prima-core:ResearchSoftware ],
        [ a owl:Restriction ;
            owl:onProperty pmd:input ;
            owl:someValuesFrom prima-core:ResearchData ],
        [ a owl:Restriction ;
            owl:onProperty pmd:output ;
            owl:someValuesFrom prima-dataset:ProcessedData ],
        pmd:Process ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/dataprocessing> .

prima-dataset:ProcessedData a owl:Class ;
    rdfs:comment "Specific type of Research Data, primary output of any kind of Data Processing performed on Research Data (typically, but not limited to, Raw Data or Reference Data). Processed Data is usually an intermediate result, to be used as input of one or more further processes, e.g., Model Preparation or Data Analysis."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/processeddata> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dcterms:references ;
            owl:someValuesFrom prima-dataset:ReferenceData ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasDerivedFrom ;
            owl:someValuesFrom prima-dataset:RawData ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasDerivedFrom ;
            owl:someValuesFrom prima-dataset:RawData ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasGeneratedBy ;
            owl:someValuesFrom prima-dal:DataProcessing ],
        [ a owl:Restriction ;
            owl:onProperty dcterms:references ;
            owl:someValuesFrom prima-dataset:ReferenceData ],
        prima-core:ResearchData ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/processeddata> .

prima-dataset:ReferenceData a owl:Class ;
    rdfs:comment "Any Research Data from prior Studies or from literature, which is used in the course of a Study to, e.g., define a Model, compare Analyzed Data, and/or validate findings and results. Reference Data is typically retrieved from publicly accessible Data Repositories. Depending on the research context, Reference Data usually undergo some kind of Data Processing before being used."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/referencedata> ;
    rdfs:subClassOf prima-core:ResearchData ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/referencedata> .

prima-dataset:isStoredIn a owl:ObjectProperty ;
    rdfs:label "is stored in"@en ;
    rdfs:comment "isStoredIn is the inverse property of stores."@en ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf prima-dataset:stores .

prima-dataset:stores a owl:ObjectProperty ;
    rdfs:label "stores"@en ;
    rdfs:comment "stores represents the relationship between data collaboration platform or data repository or metadata repository to dataset or metadata."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( prima-dataset:DataCollaborationPlatform prima-dataset:DataRepository prima-dataset:MetadataRepository ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( prima-dataset:Dataset prima-dataset:Metadata ) ] ;
    owl:inverseOf prima-dataset:isStoredIn .

prima-exp:Laboratory a owl:Class ;
    rdfs:comment "Physical or virtual place hosted by an Institution, where the Equipment (including Instruments), is located and can be physically, virtually, and/or remotely accessed to perform any of the processes during the course of a Study."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/laboratory> ;
    rdfs:subClassOf prov:Location ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/laboratory> .

ex:STRAS_Research_Group a prima-core:ResearchUser .

prima-core:DataAcquisition a owl:Class ;
    rdfs:comment "Set of actions carried out by one or more Research Users, performed on a System or a set of them to generate a single self-consistent unit of Raw Data using a Technique, an Instrument and possibly other Equipment under constant or varying conditions described by Settings, depending on the particular research context. Data Acquisition may be an experimental (Measurement) or a computational (Calculation, Simulation) process. Data Acquisition is specific to a Technique: an investigation on the same System conducted using a different Technique implies a different Data Acquisition. The output of Data Acquisition is Raw Data."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/dataacquisition> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:wasAssociatedWith ;
            owl:someValuesFrom prima-core:ResearchUser ],
        [ a owl:Restriction ;
            owl:onProperty pmd:output ;
            owl:someValuesFrom prima-core:ResearchData ],
        [ a owl:Restriction ;
            owl:onProperty pmd:input ;
            owl:someValuesFrom prima-core:ResearchData ],
        [ a owl:Restriction ;
            owl:onProperty pmd:input ;
            owl:someValuesFrom prima-core:System ],
        [ a owl:Restriction ;
            owl:onProperty prima-core:usesResearchSoftware ;
            owl:someValuesFrom prima-core:ResearchSoftware ],
        [ a owl:Restriction ;
            owl:onProperty prima-core:hasTechnique ;
            owl:someValuesFrom prima-core:Technique ],
        [ a owl:Restriction ;
            owl:onProperty prima-core:usesEquipment ;
            owl:someValuesFrom prima-core:Equipment ],
        pmd:Process ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/dataacquisition> .

prima-core:usesResearchSoftware a owl:ObjectProperty ;
    rdfs:label "uses research software"@en ;
    rdfs:comment "usesResearchSoftware represents the relationship between data acquisition, data analysis, data processing, or data curation to research software"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( prima-core:DataAcquisition prima-core:DataAnalysis prima-dal:DataProcessing prima-dataset:DataCuration ) ] ;
    rdfs:range prima-core:ResearchSoftware ;
    owl:inverseOf prima-dal:isUsedByResearchSoftware .

prima-dataset:Dataset a owl:Class ;
    rdfs:comment "Collection of scientifically related (depending on the research context) Research Data, along with their respective descriptive Metadata, formed after some kind of Data Curation. Datasets are typically stored in a Data Collaboration Platform and/or in a Data Repository. A Dataset may consist of other Datasets. The components of a Dataset remain individually identifiable." ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/dataset> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prima-dataset:isStoredIn ;
            owl:someValuesFrom prima-dataset:DataCollaborationPlatform ],
        [ a owl:Restriction ;
            owl:onProperty prima-dataset:hasMetadata ;
            owl:someValuesFrom prima-dataset:Metadata ],
        [ a owl:Restriction ;
            owl:onProperty prima-dataset:isStoredIn ;
            owl:someValuesFrom prima-dataset:DataRepository ],
        [ a owl:Restriction ;
            owl:onProperty prov:hadMember ;
            owl:someValuesFrom prima-dataset:Dataset ],
        [ a owl:Restriction ;
            owl:onProperty prov:hadMember ;
            owl:someValuesFrom prima-core:ResearchData ],
        prov:Collection,
        pmd:DigitalEntity ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/dataset> .

prima-dataset:Metadata a owl:Class ;
    rdfs:comment "Any descriptive data intended to contextualize or otherwise qualify Research Data and/or Datasets and/or Publication Data and their management through time. Typically, Metadata is created in the course of a Study and then integrated, organized, and refined during Data Curation. Examples of Metadata are: Sample properties and/or treatment history recorded in an Electronic Laboratory Notebook, Instrument parameters saved with Raw Data, analysis processes saved with Analyzed Data, Settings of a Model, but also data license, affiliation of Research Users, descriptions of how files are named, structured and stored. Metadata may be registered in a Metadata Repository and assigned a Persistent Identifier."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/metadata> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:wasAttributedTo ;
            owl:someValuesFrom prima-core:ResearchUser ],
        [ a owl:Restriction ;
            owl:onProperty prima-dataset:isStoredIn ;
            owl:someValuesFrom prima-dataset:MetadataRepository ],
        pmd:DigitalEntity ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/metadata> .

prima-exp:Measurement a owl:Class ;
    rdfs:comment "Experimental Data Acquisition performed by one or more Research Users on one or more physical Systems (Materials or Samples) using an experimental Technique. One or more Measurements may also be performed during Processing and Treatment, e.g., to characterize the intermediate stages and/or the final resulting physical System(s). A Measurement may require the use of Consumables."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/measurement> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:atLocation ;
            owl:someValuesFrom prima-exp:Laboratory ],
        [ a owl:Restriction ;
            owl:onClass prima-core:Instrument ;
            owl:onProperty prima-core:usesEquipment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty pmd:output ;
            owl:someValuesFrom prima-dataset:RawData ],
        [ a owl:Restriction ;
            owl:onProperty pmd:input ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( prima-core:Material prima-exp:Sample ) ] ],
        [ a owl:Restriction ;
            owl:onProperty prima-exp:uses ;
            owl:someValuesFrom prima-exp:Consumable ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasAssociatedWith ;
            owl:someValuesFrom prima-core:ResearchUser ],
        prima-core:DataAcquisition ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/measurement> .

prima-exp:Sample a owl:Class ;
    rdfs:comment "Physical System, composed by one or more Materials, exposed to the Instrument during a Measurement, typically after some kind of Processing and Treatment. Sample may be held by a Sample Holder and/or carried by a Sample Carrier."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/sample> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prima-exp:hasMaterial ;
            owl:someValuesFrom prima-core:Material ],
        [ a owl:Restriction ;
            owl:onProperty prima-exp:isCarriedBy ;
            owl:someValuesFrom prima-exp:SampleCarrier ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasDerivedFrom ;
            owl:someValuesFrom prima-exp:Sample ],
        prima-core:System ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/sample> .

pmd:DigitalEntity a owl:Class ;
    rdfs:subClassOf prov:Entity .

prov:wasAssociatedWith a owl:ObjectProperty .

prima-core:Study a owl:Class ;
    rdfs:comment "Set of all the processes and activities performed by one or more Research Users, who are part of the same Project, with the purpose of verifying, falsifying, or establishing the validity of a hypothesis and supporting the answer to some scientific research question. The output of a Study is usually reported in one or more Scientific Publications and may be supplemented by Publication Data." ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/study> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prima-exp:hasProcessingAndTreatment ;
            owl:someValuesFrom prima-exp:ProcessingAndTreatment ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasAttributedTo ;
            owl:someValuesFrom prima-core:ResearchUser ],
        [ a owl:Restriction ;
            owl:onProperty prima-core:hasDataAnalysis ;
            owl:someValuesFrom prima-core:DataAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty prima-exp:hasMeasurement ;
            owl:someValuesFrom prima-exp:Measurement ],
        [ a owl:Restriction ;
            owl:onProperty prima-core:hasDataAcquisition ;
            owl:someValuesFrom prima-core:DataAcquisition ],
        [ a owl:Restriction ;
            owl:onProperty prima-core:hasScientificPublication ;
            owl:someValuesFrom prima-core:ScientificPublication ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasAttributedTo ;
            owl:someValuesFrom prima-core:Project ],
        pmd:Process ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/study> .

prov:wasAttributedTo a owl:ObjectProperty .

prov:wasDerivedFrom a owl:ObjectProperty .

prima-core:ResearchSoftware a owl:Class ;
    rdfs:comment "Any software used to process, analyze, or visualize Research Data (including data rendering and or plotting)."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/researchsoftware> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prima-core:hasSetting ;
            owl:someValuesFrom prima-core:Settings ],
        prov:SoftwareAgent ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/researchsoftware> .

prima-dataset:RawData a owl:Class ;
    rdfs:comment "Specific type of Research Data, primary output of a Data Acquisition performed on a System, before any subsequent Data Processing."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/rawdata> ;
    rdfs:subClassOf prima-core:ResearchData ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/rawdata> .

prov:Entity a owl:Class .

pmd:ValueObject a owl:Class ;
    rdfs:subClassOf <http://qudt.org/schema/qudt/Quantity>,
        prov:Entity .

pmd:output a owl:ObjectProperty ;
    rdfs:subPropertyOf pmd:participant ;
    owl:inverseOf pmd:outputOf .

pmd:Object a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pmd:characteristic ;
            owl:someValuesFrom pmd:ValueObject ],
        [ a owl:Restriction ;
            owl:onProperty pmd:characteristic ;
            owl:someValuesFrom pmd:ValueObject ],
        prov:Entity .

prima-core:AgentRole a owl:Class ;
    rdfs:comment "A functional role that an Agent can perform within a research context. Roles define the responsibilities and capabilities of agents in conducting research activities."@en ;
    owl:equivalentClass prima-core:UserRole .

prima-core:Equipment a owl:Class ;
    rdfs:comment "Any kind of physical or virtual item, device, machine or other tool located in a Laboratory hosted by an Institution, which can be physically, virtually, and/or remotely accessed to perform any of the processes during the course of a Study, by applying a Technique. Equipment is usually an investment. According to this definition, an Instrument is a particular type of Equipment."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/equipment> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prima-core:hasSetting ;
            owl:someValuesFrom prima-core:Settings ],
        [ a owl:Restriction ;
            owl:onProperty prov:atLocation ;
            owl:someValuesFrom prima-exp:Laboratory ],
        prov:Agent ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/equipment> .

pmd:input a owl:ObjectProperty ;
    rdfs:subPropertyOf pmd:participant ;
    owl:inverseOf pmd:inputOf .

prima-core:ResearchData a owl:Class ;
    rdfs:comment "Data collected, created, or examined by one or more Research Users to be analyzed or considered as a basis for reasoning, discussion or calculation in a research context, with the purpose of generating, verifying, and/or validating original scientific claims that support the answer to some specific research question. According to this definition, Raw Data, Processed Data, Analyzed Data and Reference Data are particular types of Research Data. Research Data is typically in the form of one or more data files, but it may potentially be a data stream or any other form of data which is relevant in a particular data management context. Research Data may be described by Metadata and may be stored in a Data Collaboration Platform and/or in a Data Repository. Research Data may undergo some kind of Data Curation and be aggregated into a Dataset."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/researchdata> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:wasAttributedTo ;
            owl:someValuesFrom prima-core:ResearchUser ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasAttributedTo ;
            owl:someValuesFrom prima-core:ResearchUser ],
        [ a owl:Restriction ;
            owl:onProperty prima-dataset:hasMetadata ;
            owl:someValuesFrom prima-dataset:Metadata ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasAttributedTo ;
            owl:someValuesFrom prima-core:ResearchUser ],
        pmd:DigitalEntity ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/researchdata> .

pmd:Process a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pmd:output ;
            owl:someValuesFrom pmd:Object ],
        [ a owl:Restriction ;
            owl:onProperty pmd:nextProcess ;
            owl:someValuesFrom pmd:Process ],
        [ a owl:Restriction ;
            owl:onProperty pmd:input ;
            owl:someValuesFrom pmd:Object ],
        [ a owl:Restriction ;
            owl:onProperty pmd:input ;
            owl:someValuesFrom pmd:Object ],
        [ a owl:Restriction ;
            owl:onProperty pmd:subordinateProcess ;
            owl:someValuesFrom pmd:Process ],
        [ a owl:Restriction ;
            owl:onProperty pmd:output ;
            owl:someValuesFrom pmd:Object ],
        [ a owl:Restriction ;
            owl:onProperty pmd:nextProcess ;
            owl:someValuesFrom pmd:Process ],
        [ a owl:Restriction ;
            owl:onProperty pmd:subordinateProcess ;
            owl:someValuesFrom pmd:Process ],
        [ a owl:Restriction ;
            owl:onProperty pmd:characteristic ;
            owl:someValuesFrom pmd:ValueObject ],
        [ a owl:Restriction ;
            owl:onProperty pmd:characteristic ;
            owl:someValuesFrom pmd:ValueObject ],
        prov:Activity .

prima-core:ResearchUser a owl:Class ;
    rdfs:comment "Person, usually member of a Project, who conducts any part of the Study to collect and/or to analyze Research Data, and/or reuses Reference Data to extract insights that support the answer to some specific research question, usually reported in one or more Scientific Publications. A Research User may be assigned with a User Role."@en ;
    rdfs:isDefinedBy <https://purls.helmholtz-metadaten.de/skosmos/prima/researchuser> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prima-core:performsAgentRole ;
            owl:someValuesFrom prima-core:AgentRole ],
        [ a owl:Restriction ;
            owl:onProperty prima-core:operates ;
            owl:someValuesFrom prima-core:Equipment ],
        [ a owl:Restriction ;
            owl:onProperty prima-core:performsAgentRole ;
            owl:someValuesFrom prima-core:AgentRole ],
        prov:Agent ;
    skos:exactMatch <https://purls.helmholtz-metadaten.de/skosmos/prima/researchuser> .

